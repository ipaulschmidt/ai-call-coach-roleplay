# Copy this file to .env and fill in the values for your environment.
# Never commit your real .env file.

# Lovable Cloud / Supabase project ID
VITE_SUPABASE_PROJECT_ID=""

# Public (anon/publishable) key — safe to expose in the browser
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Supabase project URL
VITE_SUPABASE_URL=""

# ---------------------------------------------------------------------------
# Server-side secrets (edge functions only — never add these to .env or
# client code). Configure them in Project Settings -> Secrets:
#
#   ADMIN_PASSWORD        - password for the admin dashboard endpoints
#   ELEVENLABS_API_KEY    - (legacy) voice provider key
#   HUBSPOT_SERVICE_KEY   - private app token for session logging
#   LOVABLE_API_KEY       - managed automatically by Lovable Cloud
#   SUPABASE_SERVICE_ROLE_KEY - managed automatically by Lovable Cloud
# ---------------------------------------------------------------------------
